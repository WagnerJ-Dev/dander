# Copy to .env and fill in. .env is git-ignored — NEVER commit real values.
# In production, these are resolved from GCP Secret Manager, not .env. See steering/01-security.md.

# ── GCP core ──────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Local dev only. In cloud, use Workload Identity Federation (no key file).
GOOGLE_APPLICATION_CREDENTIALS=

# ── BigQuery target ───────────────────────────────────────────────────
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_MARTS=marts
BQ_DATASET_METADATA=dander_meta

# ── Secret resolution ─────────────────────────────────────────────────
# Local `.env`: values may be local-development credentials. Production: values should be full
# Secret Manager resource names. This committed example contains names only and never values.
SECRET_SALESFORCE=
SALESFORCE_CONNECTED_APP_CLIENT_ID=
SALESFORCE_CONNECTED_APP_PRIVATE_KEY=
SECRET_GREENHOUSE_CLIENT_ID=
SECRET_GREENHOUSE_CLIENT_SECRET=
SECRET_GREENHOUSE_LEGACY=
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
